{
  "name": "shijian-post",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run typecheck && npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.0",
    "miniflare": "latest",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
